(*
  ============================================================================
  CLB-ACEL — R3-C2 ALIGNED MODEL (ProVerif 2.05, applied pi-calculus).

  HISTORICAL NOTE — DO NOT MISREAD THE ARCHIVED RESULT:
    `clb-offchain.result.txt` (SHA-256 558F8E9A...C5AA) is the record of the
    PRE-ALIGNMENT version of this file: an off-chain-only exchange with Q1 true
    and Q2 (injective replay) FALSE. That file is preserved untouched.
    This file is the NEW aligned model; its output is archived in
    `clb-offchain-aligned.result.txt`. The Q2 result here is expected to change
    because the on-chain single-use nonce is now represented.

  What changed vs the archived model:
    - the commitment C' binds predicateId, predicateDigest, human principal
      anchor, mandateDigest and the settlement fields (R3-C1 C' binding);
    - predicate registration is a separate process emitting Registered(pid,pd);
    - the guard requires a matching registration token (config-content binding);
    - the guard requires a single-use nonce token held on a PRIVATE channel, the
      standard applied-pi encoding of the on-chain consumed[nonce] mapping.

  Queries:
    Q1  event(Settled) ==> event(Authorized)                  authentication
    Q2  inj-event(Settled) ==> inj-event(Authorized)          injective replay
    Q3  event(Settled(...,pd,...)) ==> event(Registered(pid,pd))  content binding
    Q4  attacker(skH)                                         key secrecy

  Run:  proverif formal/proverif/clb-offchain.pv
  ============================================================================
*)

free c:channel.
free regStore:channel [private].      (* registration tokens *)
free nonceStore:channel [private].    (* on-chain consumed[nonce] tokens *)

type skey.
type pkey.
fun pk(skey):pkey.
fun sign(bitstring, skey):bitstring.
reduc forall m:bitstring, k:skey; checksign(sign(m,k), pk(k)) = m.
fun h(bitstring):bitstring.

free skH:skey [private].              (* human signing key; queried in Q4 *)

event Authorized(bitstring, bitstring, bitstring, bitstring).
event Registered(bitstring, bitstring).
event Settled(bitstring, bitstring, bitstring, bitstring).

(* Q1 — authentication: expect TRUE (as before). *)
query pid:bitstring, pd:bitstring, payee:bitstring, val:bitstring;
  event(Settled(pid,pd,payee,val)) ==> event(Authorized(pid,pd,payee,val)).

(* Q2 — injective replay. Archived off-chain-only model: FALSE.
   Aligned model (on-chain nonce token): expect TRUE. *)
query pid:bitstring, pd:bitstring, payee:bitstring, val:bitstring;
  inj-event(Settled(pid,pd,payee,val)) ==> inj-event(Authorized(pid,pd,payee,val)).

(* Q3 — predicate content binding: the guard only settles under a digest that
   was actually registered. *)
query pid:bitstring, pd:bitstring, payee:bitstring, val:bitstring;
  event(Settled(pid,pd,payee,val)) ==> event(Registered(pid,pd)).

(* Q4 — human signing key secrecy: expect FALSE (attacker cannot learn it). *)
query attacker(skH).

(* Human: signs C' over (principal anchor, mandateDigest, predicateId,
   predicateDigest, settlement params). The predicate config is public because
   it is registered on-chain, so the attacker can also request registration. *)
let human(skH:skey, anchor:bitstring) =
    new pid:bitstring; new mandateDigest:bitstring; new pd:bitstring;
    new payee:bitstring; new val:bitstring;
    let C = h((anchor, mandateDigest, pid, pd, payee, val)) in
    event Authorized(pid, pd, payee, val);
    out(c, (pid, mandateDigest, pd, payee, val, sign(C, skH), h(C)));
    out(c, (pid, pd));
    out(nonceStore, (h(C), C)).

(* Registrar: permissionless, like registerPredicate; emits a token that the
   guard must possess, modelling "predicateId must be registered". *)
let registrar() =
    in(c, (pid:bitstring, pd:bitstring));
    event Registered(pid, pd);
    out(regStore, (pid, pd)).

(* Guard: validateAndConsume. Recomputes C' from the registered digest, checks
   the human signature, requires a matching registration and a single-use nonce. *)
let guard(pkH:pkey, anchor:bitstring) =
    in(c, (pid:bitstring, mandateDigest:bitstring, pd:bitstring,
           payee:bitstring, val:bitstring, s:bitstring, n:bitstring));
    let C = h((anchor, mandateDigest, pid, pd, payee, val)) in
    if checksign(s, pkH) = C then
    in(regStore, (=pid, =pd));
    in(nonceStore, (=n, =C));
    event Settled(pid, pd, payee, val).

process
    new anchor:bitstring;
    out(c, (pk(skH), anchor));
    ( !human(skH, anchor) | !registrar() | !guard(pk(skH), anchor) )
