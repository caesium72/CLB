{
  "name": "clb-acel",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "bun run --filter @clb-acel/web-demo dev",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "e2e:phase2": "bun run scripts/e2e-phase2.ts",
    "e2e:phase3": "bun run scripts/e2e-phase3.ts",
    "e2e:phase4": "bun run scripts/e2e-phase4.ts",
    "e2e:phase4b": "bun run scripts/e2e-phase4b.ts",
    "e2e:phase5": "bun run scripts/e2e-phase5.ts",
    "e2e:phase7-caveat": "bun run scripts/e2e-phase7-caveat.ts",
    "e2e:phase7-baselines": "bun run scripts/e2e-phase7-baselines.ts",
    "e2e:phase7-confidential": "bun run scripts/e2e-phase7-confidential.ts",
    "e2e:five-attacks": "bun run experiments/five-attacks-repro/run.ts",
    "setup:register-agents": "bun run scripts/register-testnet-agents.ts",
    "setup:register-canonical": "bun run scripts/register-canonical-agents.ts",
    "setup:register-orchestrator": "bun run scripts/register-orchestrator-agent.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "e2e:reviewer2:comment1": "bun run scripts/e2e-reviewer2-comment1.ts",
    "e2e:reviewer2:comment2": "bun run scripts/e2e-reviewer2-comment2.ts",
    "e2e:reviewer2:comment2:public": "bun run scripts/e2e-reviewer2-comment2-public.ts",
    "bridge:sepolia-to-base": "bun run scripts/bridge-sepolia-to-base.ts",
    "watch:mining": "bun run scripts/watch-mine-and-bridge.ts",
    "reproduce:all": "bun run scripts/reproduce-all.ts",
    "perf:all": "bun run scripts/e2e-performance.ts",
    "perf:scaling": "bun run scripts/e2e-scaling.ts",
    "novelty:aearv": "bun run scripts/e2e-aearv.ts",
    "novelty:ircv": "bun run tools/ircv/run.ts"
  },
  "devDependencies": {
    "@clb-acel/agent-orchestrator": "workspace:*",
    "@clb-acel/attack-core": "workspace:*",
    "@clb-acel/clb-core": "workspace:*",
    "@clb-acel/predicate-adapter": "workspace:*",
    "@clb-acel/x402-adapter": "workspace:*",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "bun-types": "^1.3.14",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "viem": "^2.40.0"
  }
}
