pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {PredicatePaymentGuard} from "../src/PredicatePaymentGuard.sol";

/// @notice Predicate substitution under an existing predicate ID must be rejected.
///         Golden values are generated by the clb-core package (TS/Solidity parity).
contract PredicateContentBindingTest is Test {
    PredicatePaymentGuard private guard;

    uint256 private constant CHAIN_ID = 84532;
    address private constant MERCHANT = 0x70997970C51812dc3A010C7d01b50e0d17dc79C8;
    address private constant ATTACKER = 0x90F79bf6EB2c4f870365E785982E1f101E93b906;
    address private constant REGISTRY = 0x0000000000000000000000000000000000008004;
    string private constant PREDICATE_ID = "predicate-001";
    string private constant AGENT_ID = "shopping-agent-001";
    bytes32 private constant MANDATE_DIGEST =
        0x1111111111111111111111111111111111111111111111111111111111111111;
    uint256 private constant MAX_VALUE_ATOMIC = 5_000_000; // 5.00 USDC, 6 decimals
    uint64 private constant VALID_UNTIL = 1798610400; // 2026-12-30T06:00:00.000Z
    uint256 private constant HUMAN_KEY = 0x1111111111111111111111111111111111111111111111111111111111111111;
    address private human;

    // keccak256(abi.encode([MERCHANT], [keccak("USDC")], [84532], 5_000_000, 1798610400))
    bytes32 private constant GOLDEN_PREDICATE_DIGEST =
        0xfb853dff70886f1a5f4ba72ca10c01d482c024ab6e1f90d224920b73301e02f8;
    // keccak256(abi.encode(bytes32[] agentIdHashes, bytes32 taskHash)) from clb-core
    bytes32 private constant EXTRAS_DIGEST =
        0xffcfa2c006b97b08f2715cf05ce45e0d9b24d8043ce14df8e28cc378f8a2a034;
    bytes32 private constant GOLDEN_COMMITMENT =
        0x348c47b444d31e4aed119ecaf4c7061d1f09ff35f60971f9078a5555de41f683;
    bytes32 private constant GOLDEN_NONCE =
        0xe9cda45bf35584c0eaec165cef00644d3f9b21cfeedfa9514cc12a5ff369feb0;

    function setUp() public {
        human = vm.addr(HUMAN_KEY);
        guard = new PredicatePaymentGuard(CHAIN_ID);
        vm.startPrank(human);
        _bind(guard, _legitConfig());
    }

    /// @dev Registers `cfg` under PREDICATE_ID through the enforced path. The
    ///      binding pins EXTRAS_DIGEST (the clb-core golden extras for this
    ///      fixture); `taskHash` is not exercised by the 7-arg path used here,
    ///      so it is left zero. Caller must be pranked as `human`.
    function _bind(PredicatePaymentGuard g, PredicatePaymentGuard.PredicateConfig memory cfg) internal {
        bytes32 digest = g.bindingDigest(PREDICATE_ID, cfg, human, MANDATE_DIGEST, bytes32(0), EXTRAS_DIGEST);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(HUMAN_KEY, digest);
        g.registerPredicateBound(
            PREDICATE_ID, cfg, human, MANDATE_DIGEST, bytes32(0), EXTRAS_DIGEST, abi.encodePacked(r, s, v)
        );
    }

    function _legitConfig() internal pure returns (PredicatePaymentGuard.PredicateConfig memory) {
        address[] memory payees = new address[](1);
        payees[0] = MERCHANT;
        bytes32[] memory assets = new bytes32[](1);
        assets[0] = keccak256(bytes("USDC"));
        uint256[] memory chains = new uint256[](1);
        chains[0] = CHAIN_ID;
        return PredicatePaymentGuard.PredicateConfig({
            allowedPayees: payees,
            allowedAssetHashes: assets,
            allowedChainIds: chains,
            maxValueAtomic: MAX_VALUE_ATOMIC,
            validUntil: VALID_UNTIL,
            registered: true
        });
    }

    function _identity() internal pure returns (PredicatePaymentGuard.IdentityRef memory) {
        return PredicatePaymentGuard.IdentityRef({chainId: CHAIN_ID, registryAddr: REGISTRY, agentId: AGENT_ID});
    }

    function _params(uint256 valueAtomic, string memory asset, address payTo, uint256 chainId)
        internal
        pure
        returns (PredicatePaymentGuard.SettlementParams memory)
    {
        return PredicatePaymentGuard.SettlementParams({
            chainId: chainId,
            network: "base-sepolia",
            asset: asset,
            payTo: payTo,
            value: "2.00",
            valueAtomic: valueAtomic,
            validBefore: "2026-12-30T06:00:00.000Z",
            payerAgentId: AGENT_ID
        });
    }

    function _commitment(PredicatePaymentGuard guard_, PredicatePaymentGuard.SettlementParams memory p)
        internal
        view
        returns (bytes32)
    {
        return guard_.computeSettlementCommitment(_identity(), MANDATE_DIGEST, PREDICATE_ID, EXTRAS_DIGEST, p);
    }

    // -----------------------------------------------------------------------
    // Parity + positive path
    // -----------------------------------------------------------------------

    function test_Parity_PredicateDigestAndCommitment() public view {
        assertEq(guard.predicateDigest(_legitConfig()), GOLDEN_PREDICATE_DIGEST, "config digest parity");
        assertEq(
            guard.predicateDigestWithExtras(_legitConfig(), EXTRAS_DIGEST),
            computePredicateDigestFromCore(),
            "full predicate digest parity"
        );
        PredicatePaymentGuard.SettlementParams memory p = _params(2_000_000, "USDC", MERCHANT, CHAIN_ID);
        bytes32 c = _commitment(guard, p);
        assertEq(c, GOLDEN_COMMITMENT, "C' parity with clb-core");
        assertEq(guard.deriveNonce(c), GOLDEN_NONCE, "nonce parity");
    }

    /// @dev The full digest from clb-core `computePredicateDigest` (golden value).
    function computePredicateDigestFromCore() internal pure returns (bytes32) {
        return 0xcf0ec458f42ecff8c486f641a82faf82dddc57904a328ed2b0b46049f9544475;
    }

    function test_HappyPath_ContentBoundAndConsumed() public {
        PredicatePaymentGuard.SettlementParams memory p = _params(2_000_000, "USDC", MERCHANT, CHAIN_ID);
        bytes32 c = _commitment(guard, p);
        bytes32 n = guard.deriveNonce(c);
        assertEq(guard.validateAndConsume(_identity(), MANDATE_DIGEST, PREDICATE_ID, EXTRAS_DIGEST, p, c, n), c);
        assertTrue(guard.consumed(n));
    }

    // -----------------------------------------------------------------------
    // Substitution under the SAME predicate ID
    // -----------------------------------------------------------------------

    /// @dev The reviewed attack: human signed a 5.00 cap, agent registers a
    ///      permissive 10.00 predicate under the same ID and tries to settle 9.99.
    function test_RejectsPermissiveMaxValueUnderSamePredicateId() public {
        PredicatePaymentGuard.SettlementParams memory p = _params(9_990_000, "USDC", MERCHANT, CHAIN_ID);

        // C' the human signed against the legitimate (5.00) predicate.
        bytes32 humanCommitment = _commitment(guard, p);
        bytes32 humanNonce = guard.deriveNonce(humanCommitment);

        // Agent swaps in a permissive config under the identical predicate ID.
        // The human signs that permissive config here (the "human signed a bad
        // predicate" case) so the guard's registration gate is satisfied.
        PredicatePaymentGuard.PredicateConfig memory permissive = _legitConfig();
        permissive.maxValueAtomic = 10_000_000;
        PredicatePaymentGuard swapped = new PredicatePaymentGuard(CHAIN_ID);
        _bind(swapped, permissive);

        bytes32 recomputed = _commitment(swapped, p);
        assertTrue(recomputed != humanCommitment, "predicate content must change C'");

        // The permissive config would otherwise accept 9.99 — prove that with
        // a correctly signed C' for the swapped config.
        swapped.validateAndConsume(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, EXTRAS_DIGEST, p, recomputed, swapped.deriveNonce(recomputed)
        );

        // But the human's signature is over a different C' -> binding rejection.
        vm.expectRevert(
            abi.encodeWithSelector(
                PredicatePaymentGuard.CommitmentMismatch.selector, recomputed, humanCommitment
            )
        );
        swapped.validateAndConsume(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, EXTRAS_DIGEST, p, humanCommitment, humanNonce
        );
    }

    function test_RejectsEachSwappedConfigField() public {
        PredicatePaymentGuard.SettlementParams memory p = _params(2_000_000, "USDC", MERCHANT, CHAIN_ID);
        bytes32 humanCommitment = _commitment(guard, p);
        bytes32 humanNonce = guard.deriveNonce(humanCommitment);

        _assertFieldSwapRejected(_withExtraPayee(), p, humanCommitment, humanNonce);
        _assertFieldSwapRejected(_withExtraAsset(), p, humanCommitment, humanNonce);
        _assertFieldSwapRejected(_withLongerValidUntil(), p, humanCommitment, humanNonce);
        _assertFieldSwapRejected(_withExtraChain(), p, humanCommitment, humanNonce);
        _assertFieldSwapRejected(_withHigherMax(), p, humanCommitment, humanNonce);
    }

    function _assertFieldSwapRejected(
        PredicatePaymentGuard.PredicateConfig memory cfg,
        PredicatePaymentGuard.SettlementParams memory p,
        bytes32 humanCommitment,
        bytes32 humanNonce
    ) internal {
        PredicatePaymentGuard swapped = new PredicatePaymentGuard(CHAIN_ID);
        _bind(swapped, cfg);
        bytes32 recomputed = _commitment(swapped, p);
        assertTrue(recomputed != humanCommitment, "field swap must change C'");
        vm.expectRevert(
            abi.encodeWithSelector(
                PredicatePaymentGuard.CommitmentMismatch.selector, recomputed, humanCommitment
            )
        );
        swapped.validateAndConsume(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, EXTRAS_DIGEST, p, humanCommitment, humanNonce
        );
    }

    function _withExtraPayee() internal pure returns (PredicatePaymentGuard.PredicateConfig memory cfg) {
        cfg = _legitConfig();
        address[] memory payees = new address[](2);
        payees[0] = MERCHANT;
        payees[1] = ATTACKER;
        cfg.allowedPayees = payees;
    }

    function _withExtraAsset() internal pure returns (PredicatePaymentGuard.PredicateConfig memory cfg) {
        cfg = _legitConfig();
        bytes32[] memory assets = new bytes32[](2);
        assets[0] = keccak256(bytes("USDC"));
        assets[1] = keccak256(bytes("WETH"));
        cfg.allowedAssetHashes = assets;
    }

    function _withLongerValidUntil() internal pure returns (PredicatePaymentGuard.PredicateConfig memory cfg) {
        cfg = _legitConfig();
        cfg.validUntil = VALID_UNTIL + 1000;
    }

    function _withExtraChain() internal pure returns (PredicatePaymentGuard.PredicateConfig memory cfg) {
        cfg = _legitConfig();
        uint256[] memory chains = new uint256[](2);
        chains[0] = CHAIN_ID;
        chains[1] = 1;
        cfg.allowedChainIds = chains;
    }

    function _withHigherMax() internal pure returns (PredicatePaymentGuard.PredicateConfig memory cfg) {
        cfg = _legitConfig();
        cfg.maxValueAtomic = 10_000_000;
    }

    /// @dev Agent IDs / task hash live in the off-chain extras digest; changing
    ///      it in calldata also changes C'. Since the human pinned the extras at
    ///      registration, the guard now rejects the swap before it even recomputes
    ///      C' (`ExtrasDigestMismatch`), which is strictly stronger than the old
    ///      commitment-only rejection.
    function test_RejectsSwappedExtrasDigest() public {
        PredicatePaymentGuard.SettlementParams memory p = _params(2_000_000, "USDC", MERCHANT, CHAIN_ID);
        bytes32 humanCommitment = _commitment(guard, p);
        bytes32 humanNonce = guard.deriveNonce(humanCommitment);
        bytes32 swappedExtras = keccak256("swapped-agent-ids-and-task-hash");

        bytes32 recomputed =
            guard.computeSettlementCommitment(_identity(), MANDATE_DIGEST, PREDICATE_ID, swappedExtras, p);
        assertTrue(recomputed != humanCommitment, "extras swap must change C'");
        vm.expectRevert(
            abi.encodeWithSelector(
                PredicatePaymentGuard.ExtrasDigestMismatch.selector, EXTRAS_DIGEST, swappedExtras
            )
        );
        guard.validateAndConsume(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, swappedExtras, p, humanCommitment, humanNonce
        );
    }
}
