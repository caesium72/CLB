pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {PredicatePaymentGuard} from "../src/PredicatePaymentGuard.sol";

/// @notice R3-C2 gap fixes (items 44-50). Exercises the DEMO *bounded* path
///         `registerPredicateBound` / `validateAndConsumeBound`; the legacy
///         entry points are intentionally left for parity with existing tests.
contract PredicateGuardSecurityTest is Test {
    PredicatePaymentGuard private guard;

    uint256 private constant CHAIN_ID = 84532;
    uint256 private constant HUMAN_KEY = 0x1111111111111111111111111111111111111111111111111111111111111111;
    uint256 private constant ATTACKER_KEY = 0x2222222222222222222222222222222222222222222222222222222222222222;
    address private human;
    address private attacker;
    address private constant MERCHANT = 0x70997970C51812dc3A010C7d01b50e0d17dc79C8;
    address private constant REGISTRY = 0x0000000000000000000000000000000000008004;
    string private constant PREDICATE_ID = "predicate-001";
    string private constant AGENT_ID = "shopping-agent-001";
    bytes32 private constant MANDATE_DIGEST =
        0x1111111111111111111111111111111111111111111111111111111111111111;
    bytes32 private constant TASK_HASH = keccak256("task-A");
    uint256 private constant MAX_VALUE_ATOMIC = 5_000_000;
    uint64 private constant VALID_UNTIL = 1_798_610_400; // 2026-12-30T06:00:00.000Z
    // Generated by `computePredicateExtrasDigest` / `computePredicateGuardBindingDigest`
    // in @clb-acel/clb-core for the fixture above (human = addr(0x11..11)).
    bytes32 private constant GOLDEN_EXTRAS_DIGEST =
        0x9cfaee3bc9d2bd407f7b723e6da3dad832d8fd9fd28b4f2c37a598711358980f;
    bytes32 private constant GOLDEN_BINDING_DIGEST =
        0x23af2e06491ecea1b6ab24ebedb3652050118a05f5a7216c7613792e52d27750;

    function setUp() public {
        human = vm.addr(HUMAN_KEY);
        attacker = vm.addr(ATTACKER_KEY);
        guard = new PredicatePaymentGuard(CHAIN_ID);
    }

    // --- helpers ------------------------------------------------------------

    function _config() private pure returns (PredicatePaymentGuard.PredicateConfig memory) {
        address[] memory payees = new address[](1);
        payees[0] = MERCHANT;
        bytes32[] memory assets = new bytes32[](1);
        assets[0] = keccak256(bytes("USDC"));
        uint256[] memory chains = new uint256[](1);
        chains[0] = CHAIN_ID;
        return PredicatePaymentGuard.PredicateConfig({
            allowedPayees: payees,
            allowedAssetHashes: assets,
            allowedChainIds: chains,
            maxValueAtomic: MAX_VALUE_ATOMIC,
            validUntil: type(uint64).max,
            registered: true
        });
    }

    function _agentIds() private pure returns (bytes32[] memory ids) {
        ids = new bytes32[](1);
        ids[0] = keccak256(bytes(AGENT_ID));
    }

    function _extras(bytes32[] memory ids, bytes32 task) private pure returns (bytes32) {
        return keccak256(abi.encode(ids, task));
    }

    function _signature(
        uint256 key,
        PredicatePaymentGuard.PredicateConfig memory cfg,
        address principal,
        bytes32 mandateDigest,
        bytes32 taskHash,
        bytes32 extras
    ) private view returns (bytes memory) {
        return _signatureFor(PREDICATE_ID, key, cfg, principal, mandateDigest, taskHash, extras);
    }

    function _signatureFor(
        string memory id,
        uint256 key,
        PredicatePaymentGuard.PredicateConfig memory cfg,
        address principal,
        bytes32 mandateDigest,
        bytes32 taskHash,
        bytes32 extras
    ) private view returns (bytes memory) {
        bytes32 digest = guard.bindingDigest(id, cfg, principal, mandateDigest, taskHash, extras);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(key, digest);
        return abi.encodePacked(r, s, v);
    }

    function _registerBound() private returns (bytes32 extras) {
        extras = _bind(PREDICATE_ID, _config());
    }

    /// @dev Bound-registers `id` with the human's signature and leaves the human
    ///      pranked as the settlement caller.
    function _bind(string memory id, PredicatePaymentGuard.PredicateConfig memory cfg)
        private
        returns (bytes32 extras)
    {
        extras = _extras(_agentIds(), TASK_HASH);
        vm.startPrank(human);
        guard.registerPredicateBound(
            id, cfg, human, MANDATE_DIGEST, TASK_HASH, extras, _signatureFor(id, HUMAN_KEY, cfg, human, MANDATE_DIGEST, TASK_HASH, extras)
        );
    }

    function _identity() private pure returns (PredicatePaymentGuard.IdentityRef memory) {
        return PredicatePaymentGuard.IdentityRef({chainId: CHAIN_ID, registryAddr: REGISTRY, agentId: AGENT_ID});
    }

    function _params() private pure returns (PredicatePaymentGuard.SettlementParams memory) {
        return PredicatePaymentGuard.SettlementParams({
            chainId: CHAIN_ID,
            network: "base-sepolia",
            asset: "USDC",
            payTo: MERCHANT,
            value: "2.00",
            valueAtomic: 2_000_000,
            validBefore: "2026-12-30T06:00:00.000Z",
            payerAgentId: AGENT_ID
        });
    }

    function _commitment(bytes32 extras, PredicatePaymentGuard.SettlementParams memory p)
        private
        view
        returns (bytes32)
    {
        return guard.computeSettlementCommitment(_identity(), MANDATE_DIGEST, PREDICATE_ID, extras, p);
    }

    function _settle(bytes32 extras, PredicatePaymentGuard.SettlementParams memory p, bytes32 nonce) private {
        vm.startPrank(human);
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, extras, _agentIds(), TASK_HASH, p, _commitment(extras, p), nonce
        );
    }

    // --- positives ----------------------------------------------------------

    function test_BoundRegistrationStoresHumanAnchor() public {
        bytes32 extras = _registerBound();
        assertTrue(guard.isBound(PREDICATE_ID));
        (address principal, bytes32 mandate, bytes32 task, bytes32 storedExtras, bool bound) =
            guard.bindingOf(PREDICATE_ID);
        assertTrue(bound);
        assertEq(principal, human);
        assertEq(mandate, MANDATE_DIGEST);
        assertEq(task, TASK_HASH);
        assertEq(storedExtras, extras);
    }

    function test_HappyPath_BoundSettlementConsumesNonceOnce() public {
        bytes32 extras = _registerBound();
        PredicatePaymentGuard.SettlementParams memory p = _params();
        bytes32 c = _commitment(extras, p);
        bytes32 n = guard.deriveNonce(c);

        _settle(extras, p, n);
        assertTrue(guard.consumed(n));

        vm.startPrank(human);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.NonceAlreadyConsumed.selector, n));
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, extras, _agentIds(), TASK_HASH, p, c, n
        );
    }

    function test_Parity_BindingDigestWithClbCore() public view {
        assertEq(_extras(_agentIds(), TASK_HASH), GOLDEN_EXTRAS_DIGEST, "extras digest parity");
        PredicatePaymentGuard.PredicateConfig memory cfg = _config();
        cfg.validUntil = VALID_UNTIL;
        assertEq(
            guard.bindingDigest(PREDICATE_ID, cfg, human, MANDATE_DIGEST, TASK_HASH, GOLDEN_EXTRAS_DIGEST),
            GOLDEN_BINDING_DIGEST,
            "binding digest parity with clb-core"
        );
    }

    function test_ParseUnits6_MatchesViemParseUnits() public view {
        assertEq(guard.parseUnits6("2.00"), 2_000_000);
        assertEq(guard.parseUnits6("2"), 2_000_000);
        assertEq(guard.parseUnits6("0.5"), 500_000);
        assertEq(guard.parseUnits6("0.000001"), 1);
        assertEq(guard.parseUnits6("2.000001"), 2_000_001);
        assertEq(guard.parseUnits6("0002.500000"), 2_500_000);
    }

    // --- item 44/45: authenticated registration ----------------------------

    function test_RejectsRegistrationByNonPrincipalEvenWithValidSignature() public {
        bytes32 extras = _extras(_agentIds(), TASK_HASH);
        PredicatePaymentGuard.PredicateConfig memory cfg = _config();
        bytes memory sig = _signature(HUMAN_KEY, cfg, human, MANDATE_DIGEST, TASK_HASH, extras);
        vm.startPrank(attacker);
        vm.expectRevert(
            abi.encodeWithSelector(PredicatePaymentGuard.UnauthorizedRegistrant.selector, attacker, human)
        );
        guard.registerPredicateBound(PREDICATE_ID, cfg, human, MANDATE_DIGEST, TASK_HASH, extras, sig);
        assertFalse(guard.isRegistered(PREDICATE_ID));
    }

    function test_RejectsRegistrationSignedByWrongKey() public {
        bytes32 extras = _extras(_agentIds(), TASK_HASH);
        PredicatePaymentGuard.PredicateConfig memory cfg = _config();
        bytes memory rogueSig = _signature(ATTACKER_KEY, cfg, human, MANDATE_DIGEST, TASK_HASH, extras);
        vm.startPrank(human);
        vm.expectRevert(PredicatePaymentGuard.InvalidBindingSignature.selector);
        guard.registerPredicateBound(PREDICATE_ID, cfg, human, MANDATE_DIGEST, TASK_HASH, extras, rogueSig);
    }

    function test_RejectsRegistrationWithConfigTamperedAfterSigning() public {
        bytes32 extras = _extras(_agentIds(), TASK_HASH);
        PredicatePaymentGuard.PredicateConfig memory signedCfg = _config();
        bytes memory sig = _signature(HUMAN_KEY, signedCfg, human, MANDATE_DIGEST, TASK_HASH, extras);
        PredicatePaymentGuard.PredicateConfig memory rogueCfg = _config();
        rogueCfg.maxValueAtomic = 100_000_000;
        vm.startPrank(human);
        vm.expectRevert(PredicatePaymentGuard.InvalidBindingSignature.selector);
        guard.registerPredicateBound(PREDICATE_ID, rogueCfg, human, MANDATE_DIGEST, TASK_HASH, extras, sig);
    }

    function test_LegacyRegistrationRemainsExplicitlyUnbound() public {
        guard.registerPredicate(PREDICATE_ID, _config());
        assertFalse(guard.isBound(PREDICATE_ID));
        assertTrue(guard.isRegistered(PREDICATE_ID));
        PredicatePaymentGuard.SettlementParams memory p = _params();
        bytes32 extras = _extras(_agentIds(), TASK_HASH);
        bytes32 c = guard.computeSettlementCommitment(_identity(), MANDATE_DIGEST, PREDICATE_ID, extras, p);
        bytes32 n = guard.deriveNonce(c);
        bytes32[] memory ids = _agentIds();
        vm.startPrank(human);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.PredicateNotBound.selector, keccak256(bytes(PREDICATE_ID))));
        guard.validateAndConsumeBound(_identity(), MANDATE_DIGEST, PREDICATE_ID, extras, ids, TASK_HASH, p, c, n);
    }

    // --- items 45/46/49(task): mandate, task, extras binding ----------------

    function test_RejectsWrongMandateDigest() public {
        bytes32 extras = _registerBound();
        bytes32 wrongMandate = keccak256("other-mandate");
        PredicatePaymentGuard.SettlementParams memory p = _params();
        vm.startPrank(human);
        vm.expectRevert(
            abi.encodeWithSelector(PredicatePaymentGuard.MandateDigestMismatch.selector, MANDATE_DIGEST, wrongMandate)
        );
        guard.validateAndConsumeBound(
            _identity(), wrongMandate, PREDICATE_ID, extras, _agentIds(), TASK_HASH, p, bytes32(0), bytes32(0)
        );
    }

    function test_RejectsWrongTaskHash() public {
        bytes32 extras = _registerBound();
        bytes32 wrongTask = keccak256("task-B");
        PredicatePaymentGuard.SettlementParams memory p = _params();
        vm.startPrank(human);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.TaskHashMismatch.selector, TASK_HASH, wrongTask));
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, extras, _agentIds(), wrongTask, p, bytes32(0), bytes32(0)
        );
    }

    function test_RejectsExtrasDigestSwappedAtSettlement() public {
        bytes32 extras = _registerBound();
        bytes32 swappedExtras = keccak256("swapped-agent-ids-and-task");
        PredicatePaymentGuard.SettlementParams memory p = _params();
        vm.startPrank(human);
        vm.expectRevert(
            abi.encodeWithSelector(PredicatePaymentGuard.ExtrasDigestMismatch.selector, extras, swappedExtras)
        );
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, swappedExtras, _agentIds(), TASK_HASH, p, bytes32(0), bytes32(0)
        );
    }

    function test_RejectsAgentIdsThatDoNotReproduceCommittedExtras() public {
        bytes32 extras = _registerBound();
        bytes32[] memory rogueAgents = new bytes32[](1);
        rogueAgents[0] = keccak256(bytes("rogue-agent"));
        PredicatePaymentGuard.SettlementParams memory p = _params();
        bytes32 recomputed = _extras(rogueAgents, TASK_HASH);
        vm.startPrank(human);
        vm.expectRevert(
            abi.encodeWithSelector(PredicatePaymentGuard.ExtrasDigestMismatch.selector, extras, recomputed)
        );
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, extras, rogueAgents, TASK_HASH, p, bytes32(0), bytes32(0)
        );
    }

    // --- item 48: chain cross-check ----------------------------------------

    function test_RejectsForeignIdentityChain() public {
        bytes32 extras = _registerBound();
        PredicatePaymentGuard.SettlementParams memory p = _params();
        PredicatePaymentGuard.IdentityRef memory foreign =
            PredicatePaymentGuard.IdentityRef({chainId: 1, registryAddr: REGISTRY, agentId: AGENT_ID});
        vm.startPrank(human);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.ChainIdMismatch.selector, 1, CHAIN_ID, CHAIN_ID));
        guard.validateAndConsumeBound(
            foreign, MANDATE_DIGEST, PREDICATE_ID, extras, _agentIds(), TASK_HASH, p, bytes32(0), bytes32(0)
        );
    }

    function test_RejectsSettlementChainDifferentFromDomain() public {
        bytes32 extras = _registerBound();
        PredicatePaymentGuard.SettlementParams memory p = _params();
        p.chainId = 1;
        vm.startPrank(human);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.ChainIdMismatch.selector, CHAIN_ID, 1, CHAIN_ID));
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, extras, _agentIds(), TASK_HASH, p, bytes32(0), bytes32(0)
        );
    }

    // --- item 49: decimal vs atomic ----------------------------------------

    function test_RejectsDecimalAtomicDivergence() public {
        bytes32 extras = _registerBound();
        PredicatePaymentGuard.SettlementParams memory p = _params();
        p.value = "1000.00"; // would be 1_000_000_000 at 6 decimals
        vm.startPrank(human);
        vm.expectRevert(
            abi.encodeWithSelector(PredicatePaymentGuard.AmountMismatch.selector, p.value, p.valueAtomic, uint256(1_000_000_000))
        );
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, extras, _agentIds(), TASK_HASH, p, bytes32(0), bytes32(0)
        );
    }

    function test_RejectsMalformedDecimalValue() public {
        bytes32 extras = _registerBound();
        PredicatePaymentGuard.SettlementParams memory p = _params();
        p.value = "2.0000001"; // parseUnits(value, 6) would throw off-chain too
        vm.startPrank(human);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.InvalidDecimalValue.selector, p.value));
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, extras, _agentIds(), TASK_HASH, p, bytes32(0), bytes32(0)
        );
    }

    // --- item 50: nonce griefing -------------------------------------------

    function test_RejectsNonceFrontRunningByThirdParty() public {
        bytes32 extras = _registerBound();
        PredicatePaymentGuard.SettlementParams memory p = _params();
        bytes32 c = _commitment(extras, p);
        bytes32 n = guard.deriveNonce(c);
        vm.startPrank(attacker);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.PrincipalMismatch.selector, attacker, human));
        guard.validateAndConsumeBound(
            _identity(), MANDATE_DIGEST, PREDICATE_ID, extras, _agentIds(), TASK_HASH, p, c, n
        );
        assertFalse(guard.consumed(n));
        _settle(extras, p, n); // human can still settle
        assertTrue(guard.consumed(n));
    }

    // --- item 44: the legacy (unauthenticated) path can never settle --------

    /// @dev `registerPredicate` still stores a config for fixture/inspection
    ///      purposes, but it creates no `Binding`, so both settlement overloads
    ///      revert `PredicateNotBound`.
    function test_LegacyRegistrationCannotSettle() public {
        string memory legacyId = "predicate-legacy";
        guard.registerPredicate(legacyId, _config());
        assertTrue(guard.isRegistered(legacyId));
        assertFalse(guard.isBound(legacyId));

        bytes32 extras = _extras(_agentIds(), TASK_HASH);
        PredicatePaymentGuard.SettlementParams memory p = _params();
        bytes32 c = guard.computeSettlementCommitment(_identity(), MANDATE_DIGEST, legacyId, extras, p);
        bytes32 n = guard.deriveNonce(c);
        bytes32 idHash = keccak256(bytes(legacyId));

        vm.startPrank(human);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.PredicateNotBound.selector, idHash));
        guard.validateAndConsume(_identity(), MANDATE_DIGEST, legacyId, extras, p, c, n);

        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.PredicateNotBound.selector, idHash));
        guard.validateAndConsume(_identity(), MANDATE_DIGEST, legacyId, p, c, n);

        assertFalse(guard.consumed(n), "legacy predicate consumed nothing");
    }

    /// @dev Anti-squat: an attacker can create an id through the legacy path, but
    ///      the human's bound registration takes it over and the attacker's
    ///      permissive policy stops governing it.
    function test_BoundRegistrationTakesOverSquattedId() public {
        string memory squatId = "predicate-squat";
        PredicatePaymentGuard.PredicateConfig memory permissive = _config();
        permissive.maxValueAtomic = 100_000_000;
        address[] memory payees = new address[](1);
        payees[0] = attacker;
        permissive.allowedPayees = payees;

        vm.prank(attacker);
        guard.registerPredicate(squatId, permissive);
        assertFalse(guard.isBound(squatId));

        bytes32 extras = _bind(squatId, _config());
        assertTrue(guard.isBound(squatId), "human took over the squatted id");

        // The attacker's payee allow-list is gone: settling to it now reverts.
        PredicatePaymentGuard.SettlementParams memory p = _params();
        p.payTo = attacker;
        bytes32 cRogue = guard.computeSettlementCommitment(_identity(), MANDATE_DIGEST, squatId, extras, p);
        bytes32 nRogue = guard.deriveNonce(cRogue);
        vm.expectRevert(abi.encodeWithSelector(PredicatePaymentGuard.PayeeNotAllowed.selector, attacker));
        guard.validateAndConsume(_identity(), MANDATE_DIGEST, squatId, extras, p, cRogue, nRogue);

        // The human's config settles normally under the same id.
        p.payTo = MERCHANT;
        bytes32 c = guard.computeSettlementCommitment(_identity(), MANDATE_DIGEST, squatId, extras, p);
        bytes32 n = guard.deriveNonce(c);
        guard.validateAndConsume(_identity(), MANDATE_DIGEST, squatId, extras, p, c, n);
        assertTrue(guard.consumed(n));
    }

    /// @dev The 6-arg overload takes the extras digest from the binding, not from
    ///      calldata: a C' built with zero extras is rejected, the binding-extras
    ///      C' settles and consumes.
    function test_LegacySixArgUsesBindingExtras() public {
        bytes32 extras = _registerBound();
        PredicatePaymentGuard.SettlementParams memory p = _params();
        bytes32 c = _commitment(extras, p);
        bytes32 n = guard.deriveNonce(c);

        bytes32 zeroExtrasCommitment =
            guard.computeSettlementCommitment(_identity(), MANDATE_DIGEST, PREDICATE_ID, bytes32(0), p);
        bytes32 nZero = guard.deriveNonce(zeroExtrasCommitment);
        assertTrue(zeroExtrasCommitment != c, "extras change C'");

        vm.startPrank(human);
        vm.expectRevert(
            abi.encodeWithSelector(PredicatePaymentGuard.CommitmentMismatch.selector, c, zeroExtrasCommitment)
        );
        guard.validateAndConsume(_identity(), MANDATE_DIGEST, PREDICATE_ID, p, zeroExtrasCommitment, nZero);

        assertEq(guard.validateAndConsume(_identity(), MANDATE_DIGEST, PREDICATE_ID, p, c, n), c);
        assertTrue(guard.consumed(n));
    }
}
